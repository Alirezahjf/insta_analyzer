# ============================================================
#  تنظیمات igpro + ربات تلگرام
#  کپی کنید:  copy .env.example .env   (ویندوز)
#             cp  .env.example .env    (لینوکس/ماک)
# ============================================================

# ---------------- احراز هویت اینستاگرام (یکی از سه روش) ----------------
# روش ۱ (پیشنهادی برای استفاده طولانی‌مدت): sessionid از مرورگر
IG_SESSION_ID=

# روش ۲: نام کاربری + رمز عبور
IG_USERNAME=
IG_PASSWORD=

# در صورت فعال بودن ۲FA با اپ احرازگر، seed همان اپ (کد خودکار ساخته می‌شود)
IG_TOTP_SEED=
# یا کد شش‌رقمیِ یک‌باره (فقط برای اولین اجرا)
IG_2FA_CODE=

# شماره (برای گام‌های چالش): با فرمت بین‌المللی
IG_PHONE_NUMBER=

# ---------------- شبکه ----------------
# ترنسپورت: requests (HTTP/1.1 — سازگار با VPN/پروکسی) یا curl (HTTP/2)
IG_PRIVATE_TRANSPORT=requests
# در صورت خطای شبکه با curl، یک بار خودکار با requests امتحان کند (1/0)
IG_TRANSPORT_FALLBACK=1
# متغیرهای محیطی پروکسی ویندوز (HTTP_PROXY و ...) نادیده گرفته شوند؟ (1/0)
IG_TRUST_ENV_PROXY=0
# پروکسی (اگر دارید) — وگرنه خالی بگذارید:
IG_PROXY=

# ---------------- رفتار درخواست‌ها ----------------
IG_REQUEST_TIMEOUT=20
IG_DELAY_MIN=1
IG_DELAY_MAX=3
IG_WATCHDOG_SECONDS=300
IG_CODE_WAIT_SECONDS=300
IG_LOG_LEVEL=INFO

# ---------------- مسیرها (اختیاری) ----------------
# پیش‌فرض: igpro/state
#IG_STATE_DIR=
#IG_SESSION_FILE=

# ============================================================
#  ربات تلگرام
# ============================================================
# توکن از @BotFather — محرمانه، هرگز در گیت/چت
BOT_TOKEN=

# (اختیاری) اگر ست شود، این آیدی عددی بدون قید و شرط مدیر است؛
# وگرنه اولین نفری که /start بزند مدیر می‌شود.
#BOT_ADMIN_ID=

# (اختیاری) بررسی/لاگینِ سشن در شروعِ ربات: 1 = بله، 0 = نه (پیش‌فرض)
# حالت ۰ (اقتصادی): ربات روشن می‌شود ولی هیچ درخواستی به اینستاگرام نمی‌فرستد؛
# سشن فقط در اولین درخواستِ واقعی بررسی می‌شود (گامِ اولِ پیامِ گام‌به‌قدم).
BOT_STARTUP_LOGIN=0

# (اختیاری) تعداد پست‌های نمایش‌داده‌شده در بخش هشتگ
#BOT_HASHTAG_SHOW=3
# (اختیاری) تعداد پست‌هایی که از هشتگ اسکن می‌شود
#BOT_HASHTAG_SCAN=9
